# Copy this file to .env in the backend directory before starting the backend.
# Shared MySQL server on the same private network.
DB_URL=jdbc:mysql://192.168.0.147:3306/factorypick?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=factorypick
# Must match the password configured on the MySQL server.
DB_PASSWORD=1234
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Set your own API keys in .env. Do not commit real keys.
DATA_GO_KR_SERVICE_KEY=
DATA_GO_KR_PAGE_SIZE=100
KAKAO_REST_API_KEY=
